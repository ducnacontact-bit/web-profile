generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Profile: Thông tin cá nhân
model Profile {
  id          Int      @id @default(autoincrement())
  name        String
  title       String
  bio         String   @db.Text
  avatarUrl   String?
  resumeUrl   String?
  email       String
  github      String?
  linkedin    String?
  instagram   String?
  twitter     String?
  updatedAt   DateTime @updatedAt
}

// 2. Project: Quản lý dự án
model Project {
  id          Int      @id @default(autoincrement())
  title       String   // Tên dự án
  category    String   // Danh mục
  image       String   @db.Text // Đã đổi sang @db.Text cho PostgreSQL
  span        String   @default("col-span-1 row-span-1") // Kích thước lưới CSS (Masonry)
  desc        String   // Mô tả chi tiết dự án
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. Skills: Kỹ năng chuyên môn
model Skill {
  id         Int    @id @default(autoincrement())
  name       String
  percentage Int
  category   String
}

// 4. Tools: Công cụ / Phần mềm
model Tool {
  id       Int    @id @default(autoincrement())
  name     String
  icon     String?
  category String?
}

// 5. Experience: Kinh nghiệm & Học vấn
model Experience {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  company     String
  period      String
  description String   @db.Text
}

// 6. Setting: Cài đặt chung hệ thống
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text // Đã đổi sang @db.Text cho PostgreSQL
  updatedAt DateTime @updatedAt
}

// 7. NavbarItem: Quản lý Thanh Navbar & Menu
model NavbarItem {
  id        Int          @id @default(autoincrement())
  title     String
  url       String
  parentId  Int?
  parent    NavbarItem?  @relation("NavHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavbarItem[] @relation("NavHierarchy")
}

// 8. HeroSection: Phần giới thiệu đầu trang
model HeroSection {
  id          Int      @id @default(autoincrement())
  greeting    String   @default("Hello,")
  roles       String   
  description String   @db.Text
  instagram   String?
  website     String?
  tumblr      String?
  twitter     String?
  darkBgUrl   String?  @db.Text  // Đã đổi sang @db.Text cho PostgreSQL
  lightBgUrl  String?  @db.Text  // Đã đổi sang @db.Text cho PostgreSQL
  socials     String?  @db.Text  
  updatedAt   DateTime @updatedAt
}

// 9. AboutSection: Phần thông tin chi tiết bản thân
model AboutSection {
  id          Int      @id @default(autoincrement())
  image       String   @db.Text   // Đã đổi sang @db.Text cho PostgreSQL
  paragraph1  String   @db.Text
  paragraph2  String   @db.Text
  hireMeUrl   String   @default("#contact")
  cvUrl       String   @db.Text   // Đã đổi sang @db.Text cho PostgreSQL
  updatedAt   DateTime @updatedAt
}

// 10. Service: Dịch vụ cung cấp
model Service {
  id          Int      @id @default(autoincrement())
  title       String
  iconName    String   
  shortDesc   String   @db.Text
  fullDetail  String   @db.Text
  updatedAt   DateTime @updatedAt
}

// 11. Resume: Sơ yếu lý lịch (Học tập & Làm việc)
model Resume {
  id          Int      @id @default(autoincrement())
  type        String   
  time        String   
  title       String   
  desc        String   
  institution String?  
  role        String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 12. Category: Danh mục bài viết/dự án
model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
}

// 13. Testimonial: Đánh giá từ khách hàng/đồng nghiệp
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  image     String   @db.Text // Đã đổi sang @db.Text cho PostgreSQL
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// 14. Stat: Thống kê nổi bật
model Stat {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  iconName  String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stats")
}

// 15. BlogPost: Bài viết blog
model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String   
  excerpt     String   
  content     String?  
  image       String   @db.Text // Đã đổi sang @db.Text cho PostgreSQL
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 16. Message: Tin nhắn liên hệ từ khách ghé thăm
model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  budget    String?  
  message   String
  createdAt DateTime @default(now())
}

// 17. ContactInfo: Thông tin liên hệ công khai
model ContactInfo {
  id        Int      @id @default(autoincrement())
  phone     String   @db.Text
  address   String   @db.Text
  email     String   @db.Text
  updatedAt DateTime @updatedAt
}